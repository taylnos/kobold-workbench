    <!-- Slot card titles. The cards are generic, so which of these a card
         shows depends on the material type. -->
    <floater.string name="slot_base_color">Base Color</floater.string>
    <floater.string name="slot_diffuse">Diffuse</floater.string>
    <floater.string name="slot_opacity">Opacity</floater.string>
    <floater.string name="slot_emissive">Emissive</floater.string>
    <floater.string name="slot_emissive_mask">Emissive Mask</floater.string>
    <floater.string name="slot_normal">Normal</floater.string>
    <floater.string name="slot_occlusion">Occlusion</floater.string>
    <floater.string name="slot_roughness">Roughness</floater.string>
    <floater.string name="slot_metallic">Metallic</floater.string>
    <floater.string name="slot_glossiness">Glossiness</floater.string>
    <floater.string name="slot_specular_color">Specular Color</floater.string>
    <floater.string name="slot_specular_env">Specular Env</floater.string>

    <!-- Shown on an empty slot; a filled slot shows its file path instead. -->
    <floater.string name="tip_base_color">Click to choose a base colour map</floater.string>
    <floater.string name="tip_diffuse">Click to choose a diffuse map</floater.string>
    <floater.string name="tip_opacity">Click to choose an opacity map. Without one, the colour image's own alpha is kept.</floater.string>
    <floater.string name="tip_emissive">Click to choose an emissive map</floater.string>
    <floater.string name="tip_emissive_mask">Click to choose an emissive mask. It rides in the diffuse map's alpha, so it cannot be combined with opacity.</floater.string>
    <floater.string name="tip_normal">Click to choose a normal map</floater.string>
    <floater.string name="tip_occlusion">Click to choose an ambient occlusion map</floater.string>
    <floater.string name="tip_roughness">Click to choose a roughness map</floater.string>
    <floater.string name="tip_metallic">Click to choose a metalness map</floater.string>
    <floater.string name="tip_glossiness">Click to choose a glossiness map. It rides in the normal map's alpha and scales the Glossiness slider.</floater.string>
    <floater.string name="tip_specular_color">Click to choose a specular colour map</floater.string>
    <floater.string name="tip_specular_env">Click to choose an environment intensity map. It rides in the specular map's alpha and scales the Environment slider.</floater.string>

    <floater.string name="invert_generic">Invert this channel</floater.string>
    <floater.string name="invert_normal">Flip the green channel. Second Life expects OpenGL-convention normals with +Y up; enable this for maps baked for DirectX.</floater.string>
    <floater.string name="invert_roughness">Invert this channel. Enable for a gloss or smoothness map, which is the inverse of roughness.</floater.string>
    <floater.string name="invert_glossiness">Invert this channel. Enable for a roughness map, which is the inverse of glossiness.</floater.string>

    <!-- Packed texture card titles. -->
    <floater.string name="out_base_color">Base Color</floater.string>
    <floater.string name="out_orm">Metallic Roughness</floater.string>
    <floater.string name="out_emissive">Emissive</floater.string>
